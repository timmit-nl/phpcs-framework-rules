{
    "name": "timmit/phpcs-framework-rules",
    "description": "PHPCS rules shared by aItem applications.",
    "type": "phpcodesniffer-standard",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PHP_CodeSniffer\\Standards\\TiMMiT\\": "TiMMiT/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timmit\\Phpcs\\Rules\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
